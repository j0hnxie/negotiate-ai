{
  "manifest_version": 3,
  "name": "Meet Negotiation Copilot",
  "version": "0.1.0",
  "description": "Live Google Meet negotiation assistant with transcript-aware coaching.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Negotiation Copilot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
