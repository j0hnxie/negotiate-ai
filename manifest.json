{
  "manifest_version": 3,
  "name": "NegotiateAI",
  "version": "0.2.0",
  "description": "AI-powered Google Meet negotiation assistant with live strategy, goal tracking, and offer updates.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NegotiateAI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
